    schema1:name "Research Object Crate for ORSON: workflow for prOteome and tRanScriptome functiOnal aNnotation" ;
    schema1:sdDatePublished "2024-07-12 13:36:56 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/136/ro_crate?version=1" .

