<arcp://uuid,a3979c7c-bdb1-5dd3-a916-5473e266171a/> a schema1:Dataset ;
    dct:conformsTo <https://w3id.org/ro/crate/1.1>,
        <https://w3id.org/workflowhub/workflow-ro-crate/1.0> ;
    schema1:author <arcp://uuid,a3979c7c-bdb1-5dd3-a916-5473e266171a/#person-141>,
