<arcp://uuid,4c3431ed-606f-5b09-9079-35ae2ae0e5ef/> a schema1:Dataset ;
    dct:conformsTo <https://w3id.org/ro/crate/1.1>,
        <https://w3id.org/workflowhub/workflow-ro-crate/1.0> ;
    schema1:author <arcp://uuid,4c3431ed-606f-5b09-9079-35ae2ae0e5ef/#creator-1>,
        <arcp://uuid,4c3431ed-606f-5b09-9079-35ae2ae0e5ef/#person-145>,
        <arcp://uuid,4c3431ed-606f-5b09-9079-35ae2ae0e5ef/#person-146>,
        <arcp://uuid,4c3431ed-606f-5b09-9079-35ae2ae0e5ef/#person-148>,
        <https://orcid.org/0000-0002-7139-4073> ;
    schema1:creativeWorkStatus "Stable" ;
    schema1:description """SAMBA is a FAIR scalable workflow integrating, into a unique tool, state-of-the-art bioinformatics and statistical methods to conduct reproducible eDNA analyses using Nextflow. SAMBA starts processing by verifying integrity of raw reads and metadata. Then all bioinformatics processing is done using commonly used procedure (QIIME 2 and DADA2) but adds new steps relying on dbOTU3 and microDecon to build high quality ASV count tables. Extended statistical analyses are also performed. Finally, SAMBA produces a full dynamic HTML report including resources used, commands executed, intermediate results, statistical analyses and figures.\r
\r
The SAMBA pipeline can run tasks across multiple compute infrastructures in a very portable manner. It comes with singularity containers making installation trivial and results highly reproducible.""" ;
    schema1:hasPart <arcp://uuid,4c3431ed-606f-5b09-9079-35ae2ae0e5ef/main.nf>,
        <arcp://uuid,4c3431ed-606f-5b09-9079-35ae2ae0e5ef/samba-v3.0.png> ;
    schema1:identifier "https://doi.org/10.48546/workflowhub.workflow.156.1" ;
    schema1:isBasedOn "https://github.com/ifremer-bioinformatics/samba" ;
    schema1:license "MIT" ;
    schema1:mainEntity <arcp://uuid,4c3431ed-606f-5b09-9079-35ae2ae0e5ef/main.nf> ;
    schema1:name "Research Object Crate for SAMBA: Standardized and Automated MetaBarcoding Analyses workflow" ;
    schema1:sdDatePublished "2024-07-12 13:36:48 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/156/ro_crate?version=1" .

