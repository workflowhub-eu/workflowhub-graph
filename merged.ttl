    schema1:name "Research Object Crate for Docker Classical Molecular Interaction Potentials" ;
    schema1:sdDatePublished "2024-07-12 13:23:33 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/820/ro_crate?version=1" .

