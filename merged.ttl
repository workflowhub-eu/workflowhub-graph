    schema1:isBasedOn "https://codebase.helmholtz.cloud/gernha62/reconstructing-raw-tomography-data.git" ;
    schema1:license "MIT" ;
    schema1:mainEntity <arcp://uuid,9706adc6-b34d-5ffb-a5fd-3fdc1ae61bff/workflow/Snakefile> ;
