<arcp://uuid,3b871df0-9739-5f66-87f5-a08af245a131/> a schema1:Dataset ;
    dct:conformsTo <https://w3id.org/ro/crate/1.1>,
        <https://w3id.org/workflowhub/workflow-ro-crate/1.0> ;
    schema1:author <arcp://uuid,3b871df0-9739-5f66-87f5-a08af245a131/#creator-1>,
        <arcp://uuid,3b871df0-9739-5f66-87f5-a08af245a131/#person-753>,
