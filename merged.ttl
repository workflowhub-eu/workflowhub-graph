    ns1:input <arcp://uuid,831b8e93-28d4-5216-80c9-1c4a73e74e3c/#find_transcripts___tsi-inputs-%23main/Trimmed,%20merged%20R1%20files>,
        <arcp://uuid,831b8e93-28d4-5216-80c9-1c4a73e74e3c/#find_transcripts___tsi-inputs-%23main/Trimmed,%20merged%20R2%20files>,
        <arcp://uuid,831b8e93-28d4-5216-80c9-1c4a73e74e3c/#find_transcripts___tsi-inputs-%23main/genome.fasta%20(use%20masked%20if%20available)> ;
    ns1:output <arcp://uuid,831b8e93-28d4-5216-80c9-1c4a73e74e3c/#find_transcripts___tsi-outputs-%23main/hisat2_summary_file>,
