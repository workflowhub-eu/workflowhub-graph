    schema1:isBasedOn "https://github.com/PGScatalog/pgsc_calc" ;
    schema1:license "Apache-2.0" ;
    schema1:mainEntity <arcp://uuid,30cd961f-065b-57ab-8336-913f922a41dd/main.nf> ;
