        <https://github.com/bioexcel/biobb_workflows/blob/master/biobb_wf_pmx_tutorial/python/stateA.tpr>,
        <https://github.com/bioexcel/biobb_workflows/blob/master/biobb_wf_pmx_tutorial/python/stateA_1ns.xtc>,
        <https://github.com/bioexcel/biobb_workflows/blob/master/biobb_wf_pmx_tutorial/python/stateB.tpr>,
        <https://github.com/bioexcel/biobb_workflows/blob/master/biobb_wf_pmx_tutorial/python/stateB_1ns.xtc>,
