    schema1:name "Research Object Crate for MGnify - raw-reads analysis pipeline" ;
    schema1:sdDatePublished "2024-07-12 13:35:31 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/362/ro_crate?version=1" .

