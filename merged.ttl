    schema1:producer <https://workflowhub.eu/projects/106> ;
    schema1:programmingLanguage <arcp://uuid,ff59043a-15fd-55a4-91fe-19cf0711981d/#snakemake> ;
    schema1:sdPublisher <https://about.workflowhub.eu/> ;
