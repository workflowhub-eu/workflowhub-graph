<arcp://uuid,b0206e61-045b-5306-86e2-3a9965a82761/> a schema1:Dataset ;
    dct:conformsTo <https://w3id.org/ro/crate/1.1>,
        <https://w3id.org/workflowhub/workflow-ro-crate/1.0> ;
    schema1:author <https://orcid.org/0000-0002-2961-9670>,
        <https://orcid.org/0000-0002-8122-9522>,
        <https://orcid.org/0000-0002-8330-4071> ;
    schema1:creativeWorkStatus "Stable" ;
    schema1:description """Metabolome Annotation Workflow (MAW) takes liquid chromatography tandem mass spectrometry data (LC-MS2) as .mzML format data files. It performs spectral database dereplication using R Package Spectra and compound database dereplication using MetFrag/SIRIUS. Final candidate selection is executed in Python using RDKit and PubChemPy. The classification of the tentative candidates from the input data are classified using ChemONT chemical ontology.\r
""" ;
    schema1:hasPart <arcp://uuid,b0206e61-045b-5306-86e2-3a9965a82761/cwl/maw.cwl>,
        <arcp://uuid,b0206e61-045b-5306-86e2-3a9965a82761/workflow-510-1be2bd37215a2437f0e6f1bb5bc75aa9199193b6-diagram.svg> ;
    schema1:identifier "https://doi.org/10.48546/workflowhub.workflow.510.1" ;
    schema1:isBasedOn "https://github.com/zmahnoor14/MAW" ;
    schema1:license "MIT" ;
    schema1:mainEntity <arcp://uuid,b0206e61-045b-5306-86e2-3a9965a82761/cwl/maw.cwl> ;
    schema1:name "Research Object Crate for Metabolome Annotation Workflow (MAW)" ;
    schema1:sdDatePublished "2024-07-12 13:32:44 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/510/ro_crate?version=1" .

