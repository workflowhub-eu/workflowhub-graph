\r
Licensed under the\r
[Apache License 2.0](https://www.apache.org/licenses/LICENSE-2.0), see the file LICENSE for details.\r
\r
![](https://bioexcel.eu/wp-content/uploads/2019/04/Bioexcell_logo_1080px_transp.png "Bioexcel")""" ;
    schema1:hasPart <arcp://uuid,dbb9af3d-cfbb-517b-8632-2097d0b7d24c/wf_vs_fpocket.ipynb>,
        <https://github.com/bioexcel/biobb_wf_virtual-screening/blob/main/conda_env/environment.yml> ;
    schema1:identifier "https://doi.org/10.48546/workflowhub.workflow.129.5" ;
