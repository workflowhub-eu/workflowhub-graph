    schema1:mainEntity <arcp://uuid,2b803091-29f0-55ae-ac7c-a9bba36af7c7/varscanW.cwl> ;
    schema1:name "Research Object Crate for Genomic variants - SNPs and INDELs detection using VARSCAN2." ;
    schema1:sdDatePublished "2024-07-12 13:37:34 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/31/ro_crate?version=1" .

