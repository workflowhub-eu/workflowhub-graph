    schema1:name "Research Object Crate for Pangenome databases provide superior host removal and mycobacteria classification from clinical metagenomic data" ;
    schema1:sdDatePublished "2024-07-12 13:25:36 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/700/ro_crate?version=1" .

