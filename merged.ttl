    schema1:author <arcp://uuid,bacfd9c1-af97-5c8a-a2ab-088eafd0be63/#creator-1>,
        <arcp://uuid,bacfd9c1-af97-5c8a-a2ab-088eafd0be63/#creator-10>,
        <arcp://uuid,bacfd9c1-af97-5c8a-a2ab-088eafd0be63/#creator-11>,
