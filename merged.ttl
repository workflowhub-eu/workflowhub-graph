        <arcp://uuid,b624566c-0d5f-5bea-946d-aa6d81496374/rd_connect-initial_cwl.jpg> ;
    schema1:identifier "https://workflowhub.eu/workflows/106?version=1" ;
    schema1:isBasedOn "https://github.com/inab/Wetlab2Variations/tree/eosc-life/nextflow" ;
    schema1:license "Apache-2.0" ;
    schema1:mainEntity <arcp://uuid,b624566c-0d5f-5bea-946d-aa6d81496374/nextflow.nf> ;
    schema1:name "Research Object Crate for VariantCaller_GATK3.6" ;
    schema1:sdDatePublished "2024-07-12 13:37:02 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/106/ro_crate?version=1" .

