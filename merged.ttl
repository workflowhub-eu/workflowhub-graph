    schema1:mainEntity <arcp://uuid,349f44b7-8ecc-58be-9a5d-cf741fc3f0b7/nanopore_nextflow.nf> ;
    schema1:name "Research Object Crate for ENA SARS-CoV-2 Nanopore Amplicon Sequencing Analysis Workflow" ;
    schema1:sdDatePublished "2024-07-12 13:26:45 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/104/ro_crate?version=1" .

