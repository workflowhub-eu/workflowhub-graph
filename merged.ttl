    schema1:keywords "Bioinformatics, Genomics, Snakemake, Genome assembly" ;
    schema1:license "https://spdx.org/licenses/CC-BY-4.0" ;
    schema1:name "HiC contact map generation" ;
    schema1:producer <https://workflowhub.eu/projects/163>,
        <https://workflowhub.eu/projects/202> ;
    schema1:programmingLanguage <arcp://uuid,697a0781-b620-5397-9d6e-9a01e1f510f2/#snakemake> ;
