        <https://w3id.org/workflowhub/workflow-ro-crate/1.0> ;
    schema1:author <arcp://uuid,300be37f-9661-5284-8366-5ece1135b47a/#creator-1>,
        <arcp://uuid,300be37f-9661-5284-8366-5ece1135b47a/#creator-2>,
