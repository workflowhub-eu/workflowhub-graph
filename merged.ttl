    schema1:identifier "https://doi.org/10.48546/workflowhub.workflow.524.1" ;
    schema1:isBasedOn "https://github.com/BiodataAnalysisGroup/CWL_HTS_pipelines/tree/main/RNA_Seq" ;
    schema1:license "MIT" ;
    schema1:mainEntity <arcp://uuid,f74c3fe2-ca11-57e1-96f9-4c8e4473e1e7/RNA-Seq_workflow.cwl> ;
    schema1:name "Research Object Crate for CWL-based RNA-Seq workflow" ;
    schema1:sdDatePublished "2024-07-12 13:32:56 +0100" ;
