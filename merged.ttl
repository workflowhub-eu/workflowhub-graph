    schema1:identifier "https://doi.org/10.48546/workflowhub.workflow.228.1" ;
    schema1:license "Apache-2.0" ;
    schema1:mainEntity <arcp://uuid,b77da969-6038-5fe0-9deb-ad1c2ac291fd/Galaxy-Workflow-Racon_polish_with_Illumina_reads_x2.ga> ;
    schema1:name "Research Object Crate for Racon polish with Illumina reads, x2" ;
    schema1:sdDatePublished "2024-07-12 13:36:41 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/228/ro_crate?version=1" .

