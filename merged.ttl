    ns1:input <arcp://uuid,2352e957-8f39-5b75-84cb-50482f222848/#repeat_masking___tsi-inputs-%23main/genome.fasta> ;
    ns1:output <arcp://uuid,2352e957-8f39-5b75-84cb-50482f222848/#repeat_masking___tsi-outputs-%23main/Repeats_output_table>,
        <arcp://uuid,2352e957-8f39-5b75-84cb-50482f222848/#repeat_masking___tsi-outputs-%23main/output_log>,
        <arcp://uuid,2352e957-8f39-5b75-84cb-50482f222848/#repeat_masking___tsi-outputs-%23main/output_masked_genome>,
