<https://doi.org/10.1016/j.softx.2015.06.001> a schema1:ScholarlyArticle ;
    schema1:author <https://orcid.org/0000-0001-6363-2521>,
        <https://orcid.org/0000-0002-2734-2794>,
        <https://orcid.org/0000-0002-2978-3227>,
        <https://orcid.org/0000-0002-7498-7763>,
        <https://orcid.org/0000-0003-0603-5514>,
        <https://orcid.org/0000-0003-1603-2413>,
