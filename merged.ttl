        <https://github.com/bioexcel/biobb_workflows/blob/master/biobb_wf_ligand_parameterization/python/ligand.pdb>,
        <https://github.com/bioexcel/biobb_workflows/blob/master/biobb_wf_ligand_parameterization/python/workflow.env.yml>,
        <https://github.com/bioexcel/biobb_workflows/blob/master/biobb_wf_ligand_parameterization/python/workflow.yml> ;
