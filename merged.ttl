        <https://github.com/bioexcel/biobb_workflows/blob/master/biobb_wf_flexdyn/cwl/biobb_adapters/pcz_zip.cwl>,
        <https://github.com/bioexcel/biobb_workflows/blob/master/biobb_wf_flexdyn/cwl/biobb_adapters/prody_anm.cwl>,
