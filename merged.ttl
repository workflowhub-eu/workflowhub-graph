        <arcp://uuid,160e3a46-1138-5a2c-8b42-5cc9530492e7/#combine_transcripts___tsi-inputs-%23main/coding_seqs.fasta>,
        <arcp://uuid,160e3a46-1138-5a2c-8b42-5cc9530492e7/#combine_transcripts___tsi-inputs-%23main/genome.fasta>,
