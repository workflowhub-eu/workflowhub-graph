    schema1:name "Research Object Crate for Galaxy Protein Ligand Complex MD Setup" ;
    schema1:sdDatePublished "2024-07-12 13:35:53 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/295/ro_crate?version=1" .

