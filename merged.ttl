    schema1:name "Research Object Crate for Galaxy Protein-ligand Docking tutorial (Fpocket)" ;
    schema1:sdDatePublished "2024-07-12 13:33:37 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/296/ro_crate?version=2" .

