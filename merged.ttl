<arcp://uuid,251e8f7b-e0ea-5461-827e-301856ae9759/> a schema1:Dataset ;
    dct:conformsTo <https://w3id.org/ro/wfrun/process/0.1>,
        <https://w3id.org/ro/wfrun/workflow/0.1>,
