        <arcp://uuid,23efc1ed-564e-595e-aad5-a394092ee144/#extract_transcripts___tsi-outputs-%23main/out_bed>,
        <arcp://uuid,23efc1ed-564e-595e-aad5-a394092ee144/#extract_transcripts___tsi-outputs-%23main/out_cds>,
