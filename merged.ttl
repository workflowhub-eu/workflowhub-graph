        <https://w3id.org/workflowhub/workflow-ro-crate/1.0> ;
    schema1:author <arcp://uuid,e30d03d5-a7c4-5748-8b24-85ce56831170/#creator-1>,
        <arcp://uuid,e30d03d5-a7c4-5748-8b24-85ce56831170/#creator-2>,
        <arcp://uuid,e30d03d5-a7c4-5748-8b24-85ce56831170/#creator-3>,
        <arcp://uuid,e30d03d5-a7c4-5748-8b24-85ce56831170/#creator-4>,
