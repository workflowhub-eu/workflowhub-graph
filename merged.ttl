        <https://github.com/bioexcel/biobb_workflows/blob/main/biobb_wf_cmip/docker/structure.pdb>,
        <https://github.com/bioexcel/biobb_workflows/blob/main/biobb_wf_cmip/docker/workflow.yml> ;
