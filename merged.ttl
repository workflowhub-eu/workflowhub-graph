        <arcp://uuid,23efc1ed-564e-595e-aad5-a394092ee144/#extract_transcripts___tsi-outputs-%23main/out_lo_cds>,
        <arcp://uuid,23efc1ed-564e-595e-aad5-a394092ee144/#extract_transcripts___tsi-outputs-%23main/out_lo_pep>,
        <arcp://uuid,23efc1ed-564e-595e-aad5-a394092ee144/#extract_transcripts___tsi-outputs-%23main/out_pep> .

