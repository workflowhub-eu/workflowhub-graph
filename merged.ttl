    schema1:name "Research Object Crate for ML phylogenetic reconstruction" ;
    schema1:sdDatePublished "2024-07-12 13:35:33 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/359/ro_crate?version=1" .

