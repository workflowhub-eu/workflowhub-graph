        <https://bioschemas.org/ComputationalWorkflow> ;
    dct:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/" ;
    schema1:contentSize 10412 ;
    schema1:creator <arcp://uuid,cc644a52-11a7-55e1-afb1-37a5d35308b4/#Harshil%20Patel>,
        <arcp://uuid,cc644a52-11a7-55e1-afb1-37a5d35308b4/#Phil%20Ewels>,
        <arcp://uuid,cc644a52-11a7-55e1-afb1-37a5d35308b4/#Rickard%20Hammar%C3%A9n> ;
