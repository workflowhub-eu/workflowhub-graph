    ns1:input <arcp://uuid,90fb44d8-3163-53b0-99b7-fdfc166d272f/#cwl_based_chip_seq_workflow-inputs-ChIPQC_annotation>,
        <arcp://uuid,90fb44d8-3163-53b0-99b7-fdfc166d272f/#cwl_based_chip_seq_workflow-inputs-ChIPQC_bCount>,
        <arcp://uuid,90fb44d8-3163-53b0-99b7-fdfc166d272f/#cwl_based_chip_seq_workflow-inputs-ChIPQC_blacklist>,
        <arcp://uuid,90fb44d8-3163-53b0-99b7-fdfc166d272f/#cwl_based_chip_seq_workflow-inputs-ChIPQC_consensus>,
        <arcp://uuid,90fb44d8-3163-53b0-99b7-fdfc166d272f/#cwl_based_chip_seq_workflow-inputs-ChIPQC_facetBy>,
        <arcp://uuid,90fb44d8-3163-53b0-99b7-fdfc166d272f/#cwl_based_chip_seq_workflow-inputs-DiffBind_bParallel>,
        <arcp://uuid,90fb44d8-3163-53b0-99b7-fdfc166d272f/#cwl_based_chip_seq_workflow-inputs-DiffBind_background>,
        <arcp://uuid,90fb44d8-3163-53b0-99b7-fdfc166d272f/#cwl_based_chip_seq_workflow-inputs-DiffBind_blacklist>,
        <arcp://uuid,90fb44d8-3163-53b0-99b7-fdfc166d272f/#cwl_based_chip_seq_workflow-inputs-DiffBind_consensus>,
        <arcp://uuid,90fb44d8-3163-53b0-99b7-fdfc166d272f/#cwl_based_chip_seq_workflow-inputs-DiffBind_cores>,
