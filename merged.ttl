    schema1:name "Research Object Crate for EJP-RD WP13 case-study CAKUT momix analysis" ;
    schema1:sdDatePublished "2024-07-12 13:34:56 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/126/ro_crate?version=1" .

