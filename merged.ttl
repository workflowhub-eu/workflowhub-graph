    schema1:mainEntity <arcp://uuid,1fa057ef-a179-5ce7-afe5-facfecbfb6ee/Galaxy-Workflow-Generic_consensus_construction_from_VCF_calls.ga> ;
    schema1:name "Research Object Crate for Generic consensus construction from VCF calls" ;
    schema1:sdDatePublished "2024-07-12 13:35:34 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/356/ro_crate?version=1" .

