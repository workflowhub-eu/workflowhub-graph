    schema1:creator <arcp://uuid,d39ff334-587b-5c2d-88ff-d1c30f852448/#David%20L%C3%A4hnemann>,
        <arcp://uuid,d39ff334-587b-5c2d-88ff-d1c30f852448/#Felix%20M%C3%B6lder>,
