    schema1:isBasedOn "https://github.com/AustralianBioCommons/hifi-assembly-workflow" ;
    schema1:license "MIT" ;
    schema1:mainEntity <arcp://uuid,6c404059-706c-57fe-b6b2-2cf03a259a39/main.nf> ;
    schema1:name "Research Object Crate for HiFi de novo genome assembly workflow" ;
    schema1:sdDatePublished "2024-07-12 13:27:30 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/560/ro_crate?version=1" .

<arcp://uuid,6c404059-706c-57fe-b6b2-2cf03a259a39/main.nf> a schema1:MediaObject,
