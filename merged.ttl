    schema1:isBasedOn "https://github.com/snakemake-workflows/dna-seq-varlociraptor" ;
    schema1:license "MIT" ;
    schema1:mainEntity <arcp://uuid,1253be5c-7aae-533b-a2cc-6fc6d74b0bd4/workflow/Snakefile> ;
    schema1:name "Research Object Crate for dna-seq-varlociraptor" ;
    schema1:sdDatePublished "2024-07-12 13:25:43 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/686/ro_crate?version=2" .

