<arcp://uuid,050deaea-9257-57a3-85f1-f85a32e0f3aa/> a schema1:Dataset ;
    dct:conformsTo <https://w3id.org/ro/crate/1.1>,
        <https://w3id.org/workflowhub/workflow-ro-crate/1.0> ;
    schema1:creativeWorkStatus "Stable" ;
    schema1:description """This Galaxy workflow takes a list of tumor/normal sample pair variants in VCF format and\r
1. annotates them using the ENSEMBL Variant Effect Predictor and custom annotation data\r
2. turns the annotated VCF into a MAF file for import into cBioPortal\r
3. generates human-readable variant- and gene-centric reports\r
\r
The input VCF is expected to encode somatic status, somatic p-value and germline p-value of each variant in varscan somatic format, i.e., via SS, SPV and GPV INFO keys, respectively.""" ;
    schema1:hasPart <arcp://uuid,050deaea-9257-57a3-85f1-f85a32e0f3aa/Galaxy-Workflow-Cancer_variant_annotation_(hg38_VEP-based).ga> ;
    schema1:identifier "https://doi.org/10.48546/workflowhub.workflow.607.1" ;
    schema1:license "MIT" ;
    schema1:mainEntity <arcp://uuid,050deaea-9257-57a3-85f1-f85a32e0f3aa/Galaxy-Workflow-Cancer_variant_annotation_(hg38_VEP-based).ga> ;
    schema1:name "Research Object Crate for Cancer variant annotation (hg38 VEP-based)" ;
    schema1:sdDatePublished "2024-07-12 13:27:15 +0100" ;
    schema1:url "https://workflowhub.eu/workflows/607/ro_crate?version=1" .

